{
  "manifest_version": 3,
  "name": "VoiceMixer Edge PCM",
  "version": "0.4.8",
  "minimum_chrome_version": "116",
  "description": "Edgeタブ音声をVoiceMixerへ送信します。",
  "permissions": ["activeTab", "scripting", "tabCapture", "tabs", "storage", "offscreen", "sidePanel", "downloads"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "service_worker.js", "type": "module" },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": { "default_path": "src/sidepanel.html" },
  "options_page": "src/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
